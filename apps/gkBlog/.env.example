# ===========================================
# gkBlog — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp ./apps/gkBlog/.env.example ./apps/gkBlog/.env.local
# ===========================================

# ---- Required ----

# MongoDB connection string (free tier at mongodb.com works)
# Format: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DATABASE_URL = your-database-connection-string

# Salt for anonymous session ID hashing — any random string
SALT_IP_ADDRESS = super-secret

# ---- Optional: Analytics & Integrations ----

# Baidu Analytics (百度统计)
NEXT_PUBLIC_BAIDU_TONGJI = xxxxxxxxxxxxxx

# Google Analytics (谷歌分析)
NEXT_PUBLIC_GOOGLE_ID = xxxxxxxxxxxxxx

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_TAG_ID = xxxxxxxxxxxxxx

# Twikoo Comment System (评论系统)
NEXT_PUBLIC_TWIKOO_ENVID = xxxxxxxxxxxxxx
